{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "mdx"],
    "plugins": [{ "name": "@csslit/typescript-plugin" }, { "name": "@mdx-js/typescript-plugin" }]
  },
  "include": ["src"]
}
